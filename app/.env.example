# Nada aqui é obrigatório. O modo Template roda 100% no navegador.
# Modo IA, padrão: OAuth do Claude Code (lê ~/.claude/.credentials.json da máquina do servidor; rode `claude login`).
# Modo IA, opcional: OpenRouter — o usuário informa a chave no app, ou o servidor usa esta:
OPENROUTER_API_KEY=
# Modelo padrão (canônico): claude-sonnet-5 | claude-opus-5 | slug do OpenRouter
LLM_MODEL=claude-sonnet-5
# Origem permitida no CORS (produção: o domínio do app)
ALLOWED_ORIGIN=*
