{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["@vercel/node"],
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["api/**/*.ts", "public/formats.js"],
  "exclude": ["node_modules"]
}
